{% extends "../partials/layout.njk" %}

{% block additionalHeaders %}
  <script src="https://cdn.jsdelivr.net/npm/vega@6" nonce="{{ cspNonce }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/vega-interpreter@1" nonce="{{ cspNonce }}"></script>
{% endblock %}

{% set pageTitle = applicationName + " - Match Details" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}

  {%- from "govuk/components/table/macro.njk" import govukTable -%}
  {% from "govuk/components/back-link/macro.njk" import govukBackLink %}
  {% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

  {{ govukBackLink({
    text: "Back",
    href: "/"
  }) }}

  <h1 class="govuk-heading-l heading-with-tags">Match Details</h1>

  <div class="moj-pane">
    <p>DefendantId: {{ defendantId}}</p>
    <p>Match status: {{ matchStatus}}</p>
  </div>

{% endblock %}
